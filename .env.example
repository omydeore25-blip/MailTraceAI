# ==============================================================================
# MailTrace AI - Environment Configuration
# SIH 2026 Project
# ==============================================================================

# Application
APP_NAME="MailTrace AI"
APP_ENV=development
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="insecure-development-secret-key-change-in-production-mailtrace-sih-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite fallback)
# Primary: postgresql+asyncpg://postgres:postgres@localhost:5432/mailtrace
# Fallback: sqlite+aiosqlite:///./mailtrace.db
DATABASE_URL="sqlite+aiosqlite:///./mailtrace.db"

# Graph Database (Neo4j / PostgreSQL CTE Fallback)
NEO4J_ENABLED=False
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# Threat Intelligence APIs (Leave empty to use built-in offline mock fallback)
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
IPINFO_TOKEN=""

# CORS Origins (Comma separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# AI Detector Settings
AI_MODEL_PATH="heuristic_nlp_ensemble"
ENABLE_HEAVY_TRANSFORMER=False
